# Get yours from https://dashboard.sarvam.ai (5,000 free credits for buildathon participants)
SARVAM_API_KEY=your_key_here

# Supabase auth (Google OAuth + magic link). Create a project at https://supabase.com
# Publishable key from Dashboard → Settings → API Keys (sb_publishable_…)
# https://supabase.com/docs/guides/getting-started/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key — local scripts only (npm run warm-tts-cache). sb_secret_… from Settings → API Keys.
# Never expose to the browser or Vercel.
# https://supabase.com/docs/guides/getting-started/api-keys
# SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Live voice. The same LiveKit project the NPC worker (../agent.py) registers
# with, from https://cloud.livekit.io. Without these, conversations fall back to
# push-to-talk over /api/stt, /api/talk and /api/speak.
LIVEKIT_URL=wss://your-project-xxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Canonical origin for Open Graph / Twitter link previews (no trailing slash)
# NEXT_PUBLIC_SITE_URL=https://playsadak.vercel.app

# PostHog analytics (EU). Project token from https://eu.posthog.com → Project settings
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional overrides
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3

# ---------------------------------------------------------------------------
# AWS — Bedrock (the model), Transcribe (speech in), Polly (Hindi/English out),
# DynamoDB (the learner profile and the compiled-world cache).
#
# Bedrock uses a BEDROCK API KEY, which is a bearer token, not an IAM access key
# pair — console > Bedrock > API keys > Generate long-term API key. There is no
# IAM user to create and no SigV4 to sign, which is why `lib/sim/bedrock.ts`
# needs no `@aws-sdk/*` package at all.
#
# Transcribe, Polly and DynamoDB are NOT covered by that key. They take an IAM
# access key pair (docs/AWS.md has the scoped policy) and are not wired yet.
# Never commit this file — .gitignore already has `.env*`.
# ---------------------------------------------------------------------------

# Bedrock. Bearer token; scoped to Bedrock by AmazonBedrockLimitedAccess.
AWS_BEARER_TOKEN_BEDROCK=

# us-east-1, and not Mumbai: ap-south-1 has no `apac.` inference profile for the
# Claude models (it answers "The provided model identifier is invalid"), so the
# Indian region is not an option for this part regardless of latency.
AWS_BEDROCK_REGION=us-east-1

# Where Transcribe, Polly and DynamoDB will run when they are wired. Mumbai for
# latency from India; Transcribe streaming IS available there (the five excluded
# regions are Cape Town, Tokyo, Malaysia, Thailand and Ningxia).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The model id for the speaking / reading / suggesting calls. Blank falls back
# to the default in lib/sim/bedrock.ts. If you set it, it must be an INFERENCE
# PROFILE id (`us.anthropic.…`) — every Anthropic model on Bedrock is
# profile-only, and a bare `anthropic.…` id is a 400, not a 404.
AWS_BEDROCK_MODEL=

# Set to `bedrock` to route the sim's three calls through AWS, or `groq` to keep
# the current path. Both stay wired so a demo can fall back mid-flight.
SIM_LLM_PROVIDER=groq

# DynamoDB tables. Not created yet; names are yours to change.
AWS_TABLE_LEARNER=sadak-learner
AWS_TABLE_SCENARIOS=sadak-scenarios
